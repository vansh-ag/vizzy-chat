APP_NAME=vizzy-api
APP_ENV=development
DEBUG=true

CORS_ORIGINS=http://localhost:3000

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── LLM classification (Phase 2+) ─────────────────────────────────────────
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL=openai/gpt-oss-120b

# ── Image generation (Phase 2+) ───────────────────────────────────────────
HF_TOKEN="your_hugging_face_read_token_here"
IMAGE_PROVIDER=huggingface
IMAGE_GENERATION_MODEL=black-forest-labs/FLUX.1-schnell
IMAGE_EDIT_MODEL=black-forest-labs/FLUX.1-Kontext-dev

INPUT_IMAGE_BUCKET=input-images
GENERATED_IMAGE_BUCKET=generated-images

MAX_UPLOAD_SIZE_MB=10
MAX_INPUT_IMAGES=5
